<Project Sdk="Microsoft.NET.Sdk">
  <!-- Фиктивный nearby_share.exe для проверок M5: окно класса Google.Windows.NearbyShare, маркер в логе. Окно никогда не показывается. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>nearby_share_sim</AssemblyName>
    <RootNamespace>SideBar.OfficialSim</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
