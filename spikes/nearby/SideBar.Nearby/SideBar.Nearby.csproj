<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SideBar.Nearby</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <Protobuf Include="Protos\*.proto" ProtoRoot="Protos" GrpcServices="None" />
  </ItemGroup>

  <!-- Certificate model/leveldb reader are shared with the certs spike (read-only sources). -->
  <ItemGroup>
    <Compile Include="..\..\certs\src\LevelDb.cs" Link="Certs\LevelDb.cs" />
    <Compile Include="..\..\certs\src\Snappy.cs" Link="Certs\Snappy.cs" />
    <Compile Include="..\..\certs\src\Proto.cs" Link="Certs\Proto.cs" />
    <Compile Include="..\..\certs\src\Model.cs" Link="Certs\Model.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SideBar.Nearby.Tests" />
  </ItemGroup>

</Project>
