<Window x:Class="S10Spring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="Transparent">
    <!-- the card: 2 tiles of 120 epx + 12 epx paddings = 144 x 276 epx -->
    <Border x:Name="Panel" Width="216" Height="469" HorizontalAlignment="Right" VerticalAlignment="Center"
            Margin="0,0,8,0" CornerRadius="8" BorderThickness="1" BorderBrush="#66909090">
      <Grid x:Name="Fill" CornerRadius="8" Background="#B0202020">
        <Grid Margin="12" RowDefinitions="*,12,*">
          <Border x:Name="QsTile" Grid.Row="0" CornerRadius="4" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#70909090">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
              <Border Width="72" Height="72" CornerRadius="4" Background="#22FFFFFF" HorizontalAlignment="Center">
                <TextBlock Text="QS" Foreground="#99FFFFFF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Button Content="Click" Click="OnClick" HorizontalAlignment="Center"/>
              <TextBlock x:Name="Clicks" Foreground="#CCFFFFFF" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="2">
            <Rectangle x:Name="ShelfDash" RadiusX="4" RadiusY="4" Stroke="#70909090" StrokeThickness="1" StrokeDashArray="4 3"/>
            <TextBlock x:Name="Info" Foreground="#CCFFFFFF" FontSize="10" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
