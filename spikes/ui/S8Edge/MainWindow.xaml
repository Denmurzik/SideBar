<Window x:Class="S8Edge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="Card" CornerRadius="8" BorderBrush="#70909090" BorderThickness="1" Background="#F0202020">
    <Grid Margin="12" RowDefinitions="*,12,*">
      <Border x:Name="DropZone" Grid.Row="0" AllowDrop="True" CornerRadius="4" Background="#30FFFFFF"
              DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <StackPanel VerticalAlignment="Center" Padding="6" Spacing="4">
          <TextBlock Text="Quick Share (drop)" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
          <TextBlock x:Name="DropInfo" Foreground="#CCFFFFFF" TextWrapping="Wrap" FontSize="10" Margin="6,0"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <Border x:Name="DragAll" CanDrag="True" Padding="4" CornerRadius="4" Background="#6040A0FF"
                DragStarting="OnDragAllStarting" DropCompleted="OnDragAllCompleted">
          <TextBlock x:Name="DragAllText" Foreground="White" FontSize="11" Text="Drag ALL out" HorizontalAlignment="Center"/>
        </Border>
        <ListView x:Name="Shelf" Grid.Row="1" CanDragItems="True" SelectionMode="Single"
                  DragItemsStarting="OnItemsStarting" DragItemsCompleted="OnItemsCompleted">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
  </Border>
</Window>
