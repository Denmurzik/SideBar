<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <!-- In-memory leveldb reader from the product (no temp copy on disk) for the identify option of watch. -->
    <Compile Include="..\..\src\SideBar.Nearby\Certs\LevelDbReader.cs" Link="Product\LevelDbReader.cs" />
    <Compile Include="..\..\src\SideBar.Nearby\Certs\Snappy.cs" Link="Product\Snappy.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\nearby\SideBar.Nearby\SideBar.Nearby.csproj" />
  </ItemGroup>
</Project>
