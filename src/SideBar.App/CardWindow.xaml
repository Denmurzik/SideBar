<Window x:Class="SideBar.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="Transparent">
    <Border x:Name="Panel" CornerRadius="8" BorderThickness="1">
      <Grid x:Name="Fill" CornerRadius="8">
        <Grid Margin="12" RowDefinitions="*,12,*">
          <Border x:Name="QsTile" Grid.Row="0" CornerRadius="4" Background="#14FFFFFF" BorderThickness="1">
            <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons" FontSize="40" Opacity="0.4"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Rectangle x:Name="ShelfDash" Grid.Row="2" RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="4 3"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
