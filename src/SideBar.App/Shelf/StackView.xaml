<UserControl x:Class="SideBar.Shelf.StackView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        CanDrag="True" Background="Transparent">
  <Grid Width="192" Height="216">
    <Grid Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid x:Name="Layers"/>
      <Border x:Name="Badge" Visibility="Collapsed" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0" Margin="0,-6,-8,0"
              HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource AccentFillColorDefaultBrush}">
        <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
      </Border>
    </Grid>
  </Grid>
</UserControl>
