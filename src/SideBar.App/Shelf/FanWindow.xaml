<Window x:Class="SideBar.Shelf.FanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="Transparent">
    <Border x:Name="Panel" CornerRadius="8" BorderThickness="1">
      <Grid x:Name="Fill" CornerRadius="8">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4">
          <StackPanel x:Name="Rows"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
