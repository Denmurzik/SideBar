<Window x:Class="SideBar.Sharing.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="Transparent">
    <Border x:Name="Panel" CornerRadius="8" BorderThickness="1">
      <Grid x:Name="Fill" CornerRadius="8" Padding="12">
        <StackPanel x:Name="Body" Spacing="8"/>
      </Grid>
    </Border>
  </Grid>
</Window>
